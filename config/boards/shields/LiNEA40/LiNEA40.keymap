#define ZMK_POINTING_DEFAULT_SCRL_VAL 150
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

//mouse cursol
&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll
&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};


/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};


&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT> //スクロール方向を逆転
                         , <&zip_xy_to_scroll_mapper>;
    };
};


/ {
    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <28 27>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        Home {
            bindings = <&kp HOME>;
            key-positions = <20 21>;
        };

        End {
            bindings = <&kp END>;
            key-positions = <29 28>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced"; // balanced または tap-preferred を指定する
            require-prior-idle-ms = <150>; // 125から150（または170）に増やしてみる
            tapping-term-ms = <280>; // 200から280に増やして、長押しの判定を厳しくする
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38 39 40>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced"; // balanced または tap-preferred を指定する
            require-prior-idle-ms = <150>; // 125から150（または170）に増やしてみる
            tapping-term-ms = <280>; // 200から280に増やして、長押しの判定を厳しくする
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24> 30 31 32 33 34 35; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    macros {
        BTWinW_lay0: BTWinW_lay0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 200>, <&to 0>;

            label = "BTWIN1_LAY0";
        };

        BTMac_lay3: BTMac_lay3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 200>, <&to 3>;

            label = "BTMAC_LAY3";
        };

        BTWinP_lay0: BTWin2_lay0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 200>, <&to 0>;

            label = "BTWIN2_LAY0";
        };

        BTiPad_lay3: BTiPad_layer3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&macro_wait_time 200>, <&to 3>;

            label = "BTIPAD_LAYER3";
        };

        ForwardWordDelete_Mac: ForwardWordDeleteForMac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp GLOBE &kp LA(BACKSPACE)>,
                <&macro_pause_for_release>;

            label = "FORWARDWORDDELETEFORMAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Win_Default {
            bindings = <
&kp Q             &kp W           &kp E           &kp R               &kp T                                                &kp Y             &kp U                &kp I            &kp O            &kp P
&hml LEFT_SHIFT A  &hml LEFT_GUI S  &hml LEFT_ALT D  &hml LEFT_CONTROL F  &kp G                                                &kp H             &hmr RIGHT_CONTROL J  &hmr RIGHT_ALT K  &hmr RIGHT_GUI L  &hmr RIGHT_SHIFT MINUS
&kp Z             &kp X           &kp C           &kp V               &kp B                                                &kp N             &kp M                &mkp MB1         &mkp MB3         &mkp MB2
&trans            &trans          &mo 7           &kp INS             &lt 2 LANGUAGE_2  &mt LEFT_SHIFT SPACE    &kp ENTER  &lt 1 LANGUAGE_1                       &mo 6            &trans           &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        Win_MarkNumMove {
            bindings = <
&kp NUMBER_1         &kp NUMBER_2         &kp NUMBER_3      &kp NUMBER_4      &kp N5                                     &kp NUMBER_6   &kp N7          &kp N8        &kp N9           &kp N0
&kp RIGHT_BRACKET    &kp BACKSLASH        &kp EQUAL         &kp LEFT_BRACKET  &trans                                     &kp PAGE_UP    &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW
&kp INTERNATIONAL_3  &kp INTERNATIONAL_1  &kp SINGLE_QUOTE  &kp SLASH         &trans                                     &kp PAGE_DOWN  &trans          &kp COMMA     &kp PERIOD       &kp SEMICOLON
&trans               &trans               &trans            &trans            &trans  &mt LEFT_SHIFT SPACE    &kp ENTER  &trans                         &trans        &trans           &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        Win_Func {
            bindings = <
&kp LA(F4)          &kp F7  &kp F8  &kp F9  &kp F10                    &kp LC(LG(F4))      &kp LC(LG(LEFT_ARROW))  &kp LG(TAB)          &kp LC(LG(RIGHT_ARROW))  &kp LA(PRINTSCREEN)
&kp LS(LC(ESCAPE))  &kp F4  &kp F5  &kp F6  &kp F11                    &kp LA(SPACE)       &kp LS(LC(TAB))         &kp LS(LC(T))        &kp LC(TAB)              &kp LC(BACKSPACE)
&trans              &kp F1  &kp F2  &kp F3  &kp F12                    &kp LA(LEFT_ARROW)  &kp LC(LEFT_ARROW)      &kp LA(RIGHT_ARROW)  &kp LC(RIGHT_ARROW)      &kp LC(DELETE)
&trans              &trans  &trans  &trans  &trans   &trans    &trans  &trans                                      &trans               &trans                   &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        Mac_Default {
            bindings = <
&kp Q             &kp W               &kp E           &kp R           &kp T                                                &kp Y             &kp U            &kp I            &kp O                &kp P
&hml LEFT_SHIFT A  &hml LEFT_CONTROL S  &hml LEFT_ALT D  &hml LEFT_WIN F  &kp G                                                &kp H             &hmr RIGHT_WIN J  &hmr RIGHT_ALT K  &hmr RIGHT_CONTROL L  &hmr RIGHT_SHIFT MINUS
&kp Z             &kp X               &kp C           &kp V           &kp B                                                &kp N             &kp M            &mkp MB1         &mkp MB3             &mkp MB2
&trans            &trans              &mo 7           &trans          &lt 5 LANGUAGE_2  &mt LEFT_SHIFT SPACE    &kp ENTER  &lt 4 LANGUAGE_1                   &mo 6            &trans               &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        Mac_MarkNumMove {
            bindings = <
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3      &kp NUMBER_4        &kp N5                                     &kp NUMBER_6   &kp N7          &kp N8        &kp N9           &kp N0
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp TILDE         &mt LEFT_GUI EQUAL  &trans                                     &kp PAGE_UP    &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DOWN
&kp LA(Y)         &kp PIPE           &kp SINGLE_QUOTE  &kp SLASH           &trans                                     &kp PAGE_DOWN  &trans          &kp COMMA     &kp PERIOD       &kp SEMICOLON
&trans            &trans             &trans            &trans              &trans  &mt LEFT_SHIFT SPACE    &kp ENTER  &trans                         &trans        &trans           &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        Mac_Func {
            bindings = <
&kp LC(LG(S))  &kp F7  &kp F8  &kp F9  &kp F10                    &trans              &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)     &kp LC(RIGHT_ARROW)  &trans
&trans         &kp F4  &kp F5  &kp F6  &kp F11                    &trans              &kp LS(LC(TAB))     &kp LS(LG(T))        &kp LC(TAB)          &ForwardWordDelete_Mac
&trans         &kp F1  &kp F2  &kp F3  &kp F12                    &kp LG(LEFT_ARROW)  &kp LA(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LA(DELETE)
&trans         &trans  &trans  &trans  &trans   &trans    &trans  &trans                                  &trans               &trans               &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        Setting {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &trans          &trans  &trans  &trans  &trans
&to 0         &to 3         &to 0         &to 3         &trans                               &trans          &trans  &trans  &trans  &trans
&BTWinW_lay0  &BTMac_lay3   &BTWinP_lay0  &BTiPad_lay3  &trans                               &trans          &trans  &trans  &trans  &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock          &trans  &trans  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };

        Snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans    &trans    &trans
            >;
        };
    };
};
